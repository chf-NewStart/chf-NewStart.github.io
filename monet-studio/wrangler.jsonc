{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monet-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://houfu72.com,https://www.houfu72.com,https://chf-newstart.github.io",
    // Point at a Cloudflare AI Gateway URL here to get request logs and analytics.
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    // Reads the skill and the photo, then writes the edit prompt.
    "OPENAI_MODEL": "gpt-5.5",
    "REASONING_EFFORT": "low",
    // Paints. Any GPT Image model works; gpt-image-1* falls back to its three fixed sizes.
    "OPENAI_IMAGE_MODEL": "gpt-image-2",
    "IMAGE_QUALITY": "medium",
    "IMAGE_ACTION": "edit",
    // "match" keeps the photo's aspect ratio; or pin a size such as "1024x1536" or "auto".
    "IMAGE_SIZE": "match",
    // Rough previews streamed to the page while it paints (0-3).
    "PARTIAL_IMAGES": "2",
    // Paintings per visitor per day, and for the whole studio per day (UTC).
    "DAILY_LIMIT_PER_VISITOR": "2",
    "DAILY_LIMIT_TOTAL": "25",
    "SKILL_BASE_URL": "https://raw.githubusercontent.com/chf-NewStart/Monet-light-stroke/main/skills/monet-light-strokes/"
  },
  // The daily counters live in one SQLite-backed Durable Object, which the
  // first deploy creates by itself (also on the free plan).
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA",
        "class_name": "PaintQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PaintQuota"]
    }
  ]
}
