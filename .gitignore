# macOS
.DS_Store

# Personal financial data — never commit/publish bank exports to this public site
*.ofx
*.qfx
moneymanage/*.ofx
moneymanage/*.qfx
# Billing PDFs land in this folder by accident; the site's own PDFs live in
# subdirectories, so these root-only patterns leave them alone.
/Invoice-*.pdf
/Receipt-*.pdf

# Local credentials and runtime configuration
.env
.env.*
!.env.example
__pycache__/
*.py[cod]

# Local generation scratch space and standalone working clones
tmp/
